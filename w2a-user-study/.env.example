# wake2adapt API used by the server-side /api/stt proxy
W2A_API_URL=http://127.0.0.1:8000
W2A_DOMAIN=roads
W2A_TOP_K=5

# L2-KPNS folder holding metadata/recording_targets/{domain}_200.csv (target words)
# L2_KPNS_DIR=/home/user/L2-KPNS

# HTTPS for microphone testing from another device.
# Public server 143.248.56.128: npm run setup:https:8003
# Other public IP: npm run setup:https -- <IP-address>
# Local/LAN development: npm run certs -- <IP-or-hostname>
# HTTPS_CERT_PATH=.certs/cert.pem
# HTTPS_KEY_PATH=.certs/key.pem
